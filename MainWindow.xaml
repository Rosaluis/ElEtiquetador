<Window x:Class="Etiquetador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Etiquetador"
        mc:Ignorable="d"
        Title="El Etiquetador" Height="800" Width="600"
        Topmost="True" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">

    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>



        <GroupBox Header="{local:Localize grbPrinter}" Grid.Row="0" Margin="10,30,10,10">
            <Grid ShowGridLines="True">
                <TextBox Text="{local:Localize infoTxtPrinterTest}" Margin="10,10,140,10" IsReadOnly="True" BorderThickness="0"/>
                <Button Content="{local:Localize btnPrinterTest}" HorizontalAlignment="Right" 
                Margin="0,10,10,10" Width="100" Height="25" FontSize="10"/>
            </Grid>
        </GroupBox>

        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="{local:Localize tabItemExcel}">
                <Grid Background="#FFE5E5E5">
                    <Label Content="{local:Localize tabItemExcelLblPathToForm}" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                    <TextBox HorizontalAlignment="Left" Margin="10,35,0,0" TextWrapping="Wrap" 
                             Text="{local:Localize tabItemExcelTxtPathToForm}" VerticalAlignment="Top" Width="420"/>
                    <Button Content="{local:Localize tabItemExcelBtnPathToForm}" HorizontalAlignment="Right" Margin="10,35,10,0" VerticalAlignment="Top" Width="100"/>
                    <Image HorizontalAlignment="Left" Margin="10,60,10,10" VerticalAlignment="Top"
                           Source="/Etiquetador;component/Resources/lb_nahled.bmp" Height="45" Width="200"/>
                    <Label Content="{local:Localize tabItemExcelLblFilterPathToForm}" Margin="10,120,10,10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <DataGrid x:Name="dgData" Height="300" 
                        AutoGenerateColumns="True"
                        Margin="10, 100, 10, 10" />
                    <TextBox HorizontalAlignment="Left" Margin="50,125,10,10" 
                             TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="250"/>
                    <TextBox HorizontalAlignment="Left" Margin="310,125,10,10" 
                             TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="250"/>

                </Grid>
            </TabItem>
            <TabItem Header="{local:Localize tabItemHand}">
                <Grid Background="#FFA5E5E5">
                    <Label Content="{local:Localize tabItemHandLblPathToForm}" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                    <TextBox HorizontalAlignment="Left" Margin="10,35,0,0" TextWrapping="Wrap" 
                            Text="{local:Localize tabItemHandTxtPathToForm}" VerticalAlignment="Top" Width="420"/>
                    <Button Content="{local:Localize tabItemHandBtnPathToForm}" HorizontalAlignment="Right" Margin="10,35,10,0" VerticalAlignment="Top" Width="100"/>
                </Grid>
            </TabItem>
            <TabItem Header="{local:Localize tabItemCustom}">
                <Grid Background="#FFE5FFE5">
                    <Label Content="{local:Localize tabItemCustomLblPathToForm}" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                    <TextBox HorizontalAlignment="Left" Margin="10,35,0,0" TextWrapping="Wrap" 
                            Text="{local:Localize tabItemCustomTxtPathToForm}" VerticalAlignment="Top" Width="420"/>
                    <Button Content="{local:Localize tabItemCustomBtnPathToForm}" HorizontalAlignment="Right" Margin="10,35,10,0" VerticalAlignment="Top" Width="100"/>
                </Grid>
            </TabItem>
        </TabControl>
        <Button Content="{local:Localize btnEnd}" HorizontalAlignment="Left" Margin="475,25,0,0" Grid.Row="2" VerticalAlignment="Top" Height="25" Width="100" Click="btnEnd_Click"/>
        <Button Content="{local:Localize btnToogleLanguage}" HorizontalAlignment="Left" Margin="10,25,0,0" VerticalAlignment="Top" Grid.Row="2" Height="25" Width="100" Click="btnToogleLanguage_Click"/>
        <Image HorizontalAlignment="Left" Height="70" Margin="200,10,10,10" Source="/Etiquetador;component/Resources/PT-E550W_pic.bmp" VerticalAlignment="Center" 
               Width="40" Grid.Row="2">
            <Image.RenderTransform>
                <RotateTransform Angle="90"/>
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>