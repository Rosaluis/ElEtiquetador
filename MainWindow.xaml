<Window x:Class="Etiquetador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Etiquetador"
        mc:Ignorable="d"
        Title="El Etiquetador" Height="800" Width="600"
        Topmost="True" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">

    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Printer" Grid.Row="0" Margin="10,30,10,10">
            <Grid ShowGridLines="True">
                <TextBox Text="information about printer..." Margin="10,10,140,10"/>
                <Button Content="Test printer" HorizontalAlignment="Right" 
                Margin="0,10,10,10" Width="100" Height="25"/>
            </Grid>
        </GroupBox>

        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Excel">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>
            <TabItem Header="Hand">
                <Grid Background="#FFA5E5E5"/>
            </TabItem>
            <TabItem Header="Custom">
                <Grid Background="#FFE5FFE5"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>